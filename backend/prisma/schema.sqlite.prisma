datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  name             String?
  avatar           String?
  googleId         String?     @unique
  slackWebhookUrl  String?
  slackAccessToken String?
  slackChannel     String?
  slackTeamName    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  emailJobs        EmailJob[]
}

model EmailJob {
  id                 String    @id @default(cuid())
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderEmail        String
  recipientEmail     String
  subject            String
  body               String
  status             String    @default("SCHEDULED") // SCHEDULED, PROCESSING, SENT, FAILED, RATE_LIMITED, CANCELLED
  scheduledAt        DateTime
  sentAt             DateTime?
  failedReason       String?
  etherealPreviewUrl String?
  bullJobId          String?
  batchId            String?
  delayBetweenEmails Int?      @default(2000)
  hourlyLimit        Int?      @default(200)
  attempts           Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SenderConfig {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  hourlyLimit Int      @default(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RateLimitEvent {
  id            String   @id @default(cuid())
  senderEmail   String
  hourWindow    String
  count         Int
  limit         Int
  slackNotified Boolean  @default(false)
  rescheduledTo DateTime?
  createdAt     DateTime @default(now())
}
